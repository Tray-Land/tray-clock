<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayClock.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrayClock.Views"
    Background="Transparent">

    <Grid Padding="16,12,12,12" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tray Clock" />
            <ToggleButton
                x:Name="AddCityButton"
                Grid.Column="1"
                AutomationProperties.Name="Add city"
                Checked="AddCityButton_Toggled"
                Unchecked="AddCityButton_Toggled"
                Style="{StaticResource FlyoutIconToggleButtonStyle}"
                ToolTipService.ToolTip="Add city">
                <FontIcon FontSize="14" Glyph="&#xE710;" />
            </ToggleButton>
            <ToggleButton
                x:Name="TimeShiftButton"
                Grid.Column="2"
                AutomationProperties.Name="Time shift"
                Checked="TimeShiftButton_Toggled"
                Unchecked="TimeShiftButton_Toggled"
                Style="{StaticResource FlyoutIconToggleButtonStyle}"
                ToolTipService.ToolTip="Compare a different time">
                <FontIcon FontSize="14" Glyph="&#xE121;" />
            </ToggleButton>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <Pivot
            x:Name="Tabs"
            Grid.Row="1"
            Margin="0,0,4,0"
            SelectionChanged="Tabs_SelectionChanged">
            <!--  Clocks  -->
            <PivotItem Header="Clocks">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ComboBox
                        x:Name="CityPicker"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Add a city"
                        PlaceholderText="Add a city…"
                        SelectionChanged="CityPicker_SelectionChanged" />


                    <ListView
                        x:Name="CityList"
                        Grid.Row="1"
                        AllowDrop="True"
                        CanReorderItems="True"
                        ContainerContentChanging="CityList_ContainerContentChanging"
                        DragItemsCompleted="CityList_DragItemsCompleted"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CityRow">
                                <SwipeControl>
                                    <Grid Padding="0,4,8,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Detail, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind Time, Mode=OneWay}"
                                            TextAlignment="Right"
                                            Visibility="{x:Bind TimeVisibility, Mode=OneWay}" />
                                        <Viewbox
                                            Grid.ColumnSpan="2"
                                            Width="190"
                                            HorizontalAlignment="Right"
                                            StretchDirection="DownOnly"
                                            Visibility="{x:Bind PickerVisibility, Mode=OneWay}">
                                            <TimePicker
                                                AutomationProperties.Name="Local time to compare"
                                                SelectedTime="{x:Bind PlannedTime, Mode=TwoWay}" />
                                        </Viewbox>
                                    </Grid>
                                </SwipeControl>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!--  Stopwatch  -->
            <PivotItem Header="Stopwatch">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="StopwatchText"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="48"
                        Text="00:00.00" />
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="StopwatchStartButton"
                            MinWidth="88"
                            Click="StopwatchStart_Click"
                            Content="Start"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="StopwatchLapButton"
                            MinWidth="88"
                            Click="StopwatchLap_Click"
                            Content="Lap" />
                        <Button
                            x:Name="StopwatchResetButton"
                            MinWidth="88"
                            Click="StopwatchReset_Click"
                            Content="Reset" />
                    </StackPanel>
                    <ListView
                        x:Name="LapList"
                        Grid.Row="2"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock FontFamily="Consolas" Text="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!--  Timers  -->
            <PivotItem Header="Timers">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="PresetTimer_Click" Content="1 min" Tag="60" />
                        <Button Click="PresetTimer_Click" Content="5 min" Tag="300" />
                        <Button Click="PresetTimer_Click" Content="10 min" Tag="600" />
                        <Button Click="PresetTimer_Click" Content="25 min" Tag="1500" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="HoursBox" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="5" Header="Hours" Minimum="0" Maximum="99" Value="0" />
                        <NumberBox x:Name="MinutesBox" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="5" Grid.Column="1" Header="Min" Minimum="0" Maximum="999" Value="0" />
                        <NumberBox x:Name="SecondsBox" SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="5" Grid.Column="2" Header="Sec" Minimum="0" Maximum="999" Value="0" />
                    </Grid>

                    <Button
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        Click="CustomTimer_Click"
                        Content="Start timer"
                        Style="{StaticResource AccentButtonStyle}" />

                    <ListView
                        x:Name="TimerListView"
                        Grid.Row="3"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TimerRow">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Label}"
                                            TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        Style="{StaticResource TitleTextBlockStyle}"
                                        Text="{x:Bind Remaining, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.Name="Start or pause"
                                        Click="ToggleTimer_Click"
                                        Style="{StaticResource FlyoutIconButtonStyle}"
                                        Tag="{x:Bind Id}">
                                        <FontIcon FontSize="12" Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                    </Button>
                                    <Button
                                        Grid.Column="3"
                                        AutomationProperties.Name="Delete timer"
                                        Click="RemoveTimer_Click"
                                        Style="{StaticResource FlyoutIconButtonStyle}"
                                        Tag="{x:Bind Id}">
                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
